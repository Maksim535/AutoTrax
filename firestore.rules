

// Korisnik koji je prijavljen može čitati, dodavati, uređivati i brisati podatke
// Samo rpikaz sta sam stavio u Firebase - Database and Storage - Firestore - Rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /{document=**} {
      allow read, write: if request.auth != null;
    }

  }
}